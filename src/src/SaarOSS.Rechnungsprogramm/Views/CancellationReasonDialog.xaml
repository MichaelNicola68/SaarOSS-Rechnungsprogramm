<Window x:Class="SaarOSS.Rechnungsprogramm.Views.CancellationReasonDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rechnung stornieren" Width="520" Height="280" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F6F8F7" ShowInTaskbar="False"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Stornierungsgrund" FontSize="22" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Die Rechnung bleibt erhalten und wird dauerhaft als storniert gekennzeichnet." Foreground="#52625A" TextWrapping="Wrap" Margin="0,8,0,14"/><TextBox x:Name="ReasonBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="500" Padding="10"/><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Abbrechen" Click="CancelClick"/><Button Style="{StaticResource PrimaryButton}" Content="Weiter" Click="ContinueClick"/></StackPanel></Grid></Window>