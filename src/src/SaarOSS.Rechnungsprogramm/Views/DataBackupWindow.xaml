<Window x:Class="SaarOSS.Rechnungsprogramm.Views.DataBackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Datensicherung" Width="760" Height="560" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F4F7F5"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Datensicherung" FontSize="28" FontWeight="Bold"/><TextBlock Grid.Row="1" Margin="0,8,0,18" Text="Sichert die lokalen Programmdaten in eine geprüfte ZIP-Datei mit genau einem Hauptordner." Foreground="#52625A" TextWrapping="Wrap"/><Border Grid.Row="2" Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Sicherungsordner" FontWeight="SemiBold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TargetBox" Height="38" VerticalContentAlignment="Center" IsReadOnly="True"/><Button Grid.Column="1" Content="Ordner auswählen" Click="ChooseFolder" Margin="10,0,0,0"/></Grid><TextBlock Text="Gesichert werden die vorhandenen Dateien aus %LOCALAPPDATA%\SaarOSS\Rechnungsprogramm. Die Quelldaten bleiben unverändert." TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#52625A"/><Button x:Name="BackupButton" Style="{StaticResource PrimaryButton}" Content="Datensicherung jetzt erstellen" Click="CreateBackup" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border><Border Grid.Row="3" Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,16,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResultText" Text="Noch keine Datensicherung in diesem Fenster erstellt." TextWrapping="Wrap"/></ScrollViewer></Border><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Sicherungsordner öffnen" Click="OpenFolder"/><Button Content="Schließen" Click="CloseWindow"/></StackPanel></Grid></Window>