<Window x:Class="SaarOSS.Rechnungsprogramm.Views.TaxProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Besteuerung" Width="760" Height="650" MinWidth="680" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F4F7F5"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26"><TextBlock Text="Besteuerung" FontSize="28" FontWeight="Bold"/><TextBlock Text="Die Auswahl steuert künftig die Umsatzsteuerbehandlung neuer Angebote und Rechnungen. Die rechtliche Einstufung erfolgt nicht automatisch." TextWrapping="Wrap" Foreground="#52625A" Margin="0,8,0,18"/><Border Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="Besteuerungsart" FontWeight="SemiBold"/><RadioButton x:Name="RegularBox" Content="Regelbesteuerung" GroupName="TaxMode" Margin="0,12,0,0"/><RadioButton x:Name="SmallBox" Content="Kleinunternehmer gemäß § 19 UStG" GroupName="TaxMode" Margin="0,10,0,0" Checked="ModeChanged" Unchecked="ModeChanged"/><Border Background="#FFF8E6" BorderBrush="#E3C66F" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,0"><TextBlock Text="Wichtig: Die Umsatzgrenzen sind Informationswerte. Das Programm entscheidet nicht automatisch über die steuerliche Einstufung." TextWrapping="Wrap"/></Border><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Informationsgrenze Vorjahr"/><TextBox x:Name="PreviousBox" IsReadOnly="True" Text="25.000 €" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Informationsgrenze laufendes Jahr"/><TextBox x:Name="CurrentBox" IsReadOnly="True" Text="100.000 €" Margin="0,5,0,0"/></StackPanel></Grid><TextBlock Text="Rechtsstand geprüft am 17.11.2026 · Quelle: § 19 UStG" Foreground="#52625A" Margin="0,10,0,0"/><TextBlock Text="Pflichttext auf Dokumenten" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBox x:Name="NoticeBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500"/><TextBlock Text="Der Pflichttext darf im Kleinunternehmermodus nicht leer sein." Foreground="#52625A" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#EFF7F2" BorderBrush="#B8D7C2" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0"><TextBlock Text="Sicherheit: Bereits abgeschlossene Angebote und Rechnungen werden durch diese Einstellung nicht bearbeitet. Vor einer späteren Umstellung der Berechnungslogik werden vorhandene Entwürfe gesondert geprüft." TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Besteuerungsart speichern" Click="Save"/><Button Content="Abbrechen" Click="Cancel"/></StackPanel></StackPanel></ScrollViewer></Window>