<Window x:Class="SaarOSS.Rechnungsprogramm.Views.OfferPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Angebotsvorschau" Width="1080" Height="820" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#E7ECE9"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" BorderBrush="#D7DFDA" BorderThickness="0,0,0,1" Padding="16"><Grid><TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource PrimaryButton}" Content="Als PDF speichern" Click="SavePdf"/><Button Content="Drucken" Click="Print"/><Button Content="Schließen" Click="CloseWindow"/></StackPanel></Grid></Border><FlowDocumentReader x:Name="Reader" Grid.Row="1" Margin="18" ViewingMode="Page" IsFindEnabled="True" IsPrintEnabled="False" Zoom="100" MinZoom="50" MaxZoom="250" ZoomIncrement="10"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,12"><Button Content="-" Width="42" Click="ZoomOut"/><Slider x:Name="ZoomSlider" Width="260" Minimum="50" Maximum="250" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="ZoomChanged" Margin="10,0"/><Button Content="+" Width="42" Click="ZoomIn"/><Button Content="100 %" Click="ZoomReset" Margin="12,0,0,0"/><Button Content="Seite einpassen" Click="FitPage" Margin="8,0,0,0"/><TextBlock x:Name="ZoomText" Text="100 %" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/></StackPanel></Grid></Window>