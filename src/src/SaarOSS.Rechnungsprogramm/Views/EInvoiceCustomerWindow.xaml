<Window x:Class="SaarOSS.Rechnungsprogramm.Views.EInvoiceCustomerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="E-Rechnungsdaten der Kunden" Width="760" Height="700" MinWidth="680" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F3F6F4"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="E-Rechnungsdaten der Kunden" FontSize="25" FontWeight="Bold"/><TextBlock Text="Bestehende Kunden verwenden standardmäßig PDF. Die Angaben werden getrennt und abwärtskompatibel gespeichert." Foreground="#52625A" TextWrapping="Wrap" Margin="0,6,0,16"/><TextBlock Text="Kunde *"/><ComboBox x:Name="CustomerBox" Height="38" Margin="0,5,0,0" SelectionChanged="CustomerChanged"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,16" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="CustomerNumberText" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Kundentyp"/><ComboBox x:Name="TypeBox" Margin="0,5,0,0" Height="36"><ComboBoxItem Content="Privatkunde"/><ComboBoxItem Content="Unternehmen"/><ComboBoxItem Content="Öffentliche Verwaltung"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Bevorzugtes Rechnungsformat"/><ComboBox x:Name="FormatBox" Margin="0,5,0,0" Height="36"><ComboBoxItem Content="PDF"/><ComboBoxItem Content="XRechnung"/><ComboBoxItem Content="ZUGFeRD (später)" IsEnabled="False"/></ComboBox></StackPanel></Grid><TextBlock Text="E-Rechnungs-E-Mail" Margin="0,16,0,5"/><TextBox x:Name="EmailBox"/><TextBlock Text="Leitweg-ID (bei öffentlicher Verwaltung)" Margin="0,14,0,5"/><TextBox x:Name="RoutingBox"/><TextBlock Text="Bestellreferenz / Auftragsnummer" Margin="0,14,0,5"/><TextBox x:Name="BuyerReferenceBox"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Abteilung"/><TextBox x:Name="DepartmentBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ansprechpartner"/><TextBox x:Name="ContactBox" Margin="0,5,0,0"/></StackPanel></Grid><Border Background="#EFF7F2" BorderBrush="#B8D7C2" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,18,0,0"><TextBlock Text="Hinweis: XRechnung ist in diesem Schritt nur eine Kundenpräferenz. Der XML-Export folgt in einem späteren Alpha-8-Schritt." TextWrapping="Wrap"/></Border><TextBlock x:Name="StatusText" Foreground="#14532D" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Schließen" Click="CloseWindow"/><Button Style="{StaticResource PrimaryButton}" Content="E-Rechnungsdaten speichern" Click="Save"/></StackPanel></Grid></Window>