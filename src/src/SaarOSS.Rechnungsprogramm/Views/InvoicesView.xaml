<UserControl x:Class="SaarOSS.Rechnungsprogramm.Views.InvoicesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><TextBlock Text="Rechnungen" FontSize="27" FontWeight="Bold"/><Button Style="{StaticResource PrimaryButton}" Content="+ Neue Rechnung" Click="NewDraft" HorizontalAlignment="Right" Margin="0"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="650"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="Vorgänge" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="DraftCountText" HorizontalAlignment="Right" Foreground="#52625A"/></Grid><ListView x:Name="DraftList" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="DraftSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.View><GridView><GridViewColumn Header="Nummer" Width="140" DisplayMemberBinding="{Binding DisplayNumber}"/><GridViewColumn Header="Kunde" Width="135" DisplayMemberBinding="{Binding CustomerName}"/><GridViewColumn Header="Vorgang" Width="90" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Zahlung" Width="115" DisplayMemberBinding="{Binding PaymentStatusDisplay}"/><GridViewColumn Header="Offen" Width="90" DisplayMemberBinding="{Binding OpenAmountDisplay}"/><GridViewColumn Header="Betrag" Width="92" DisplayMemberBinding="{Binding GrossTotalDisplay}"/></GridView></ListView.View></ListView></Grid></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="20,20,12,20"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"><StackPanel Margin="0,0,4,0"><Grid><TextBlock x:Name="EditorTitle" Text="Neue Rechnung" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="NumberText" HorizontalAlignment="Right" Foreground="#52625A"/></Grid><Border x:Name="StatusBanner" Background="#EFF7F2" BorderBrush="#B8D7C2" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,12,0,0"><TextBlock x:Name="StatusBannerText" FontWeight="SemiBold"/></Border><StackPanel x:Name="EditorPanel"><TextBlock Text="Kunde *" Margin="0,16,0,5"/><ComboBox x:Name="CustomerBox" Height="36" SelectionChanged="CustomerChanged"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rechnungsdatum"/><DatePicker x:Name="InvoiceDatePicker" Margin="0,5,0,0" SelectedDateChanged="DateChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Leistungsdatum"/><DatePicker x:Name="ServiceDatePicker" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Zahlungsziel (Tage)"/><TextBox x:Name="PaymentTermBox" Margin="0,5,0,0" TextChanged="PaymentChanged"/></StackPanel></Grid><TextBlock x:Name="DueDateText" Foreground="#52625A" Margin="0,8,0,0"/><Separator Margin="0,18"/><Grid><TextBlock Text="Positionen" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AddLineButton" Content="+ Position" Click="AddLine"/><Button x:Name="RemoveLineButton" Content="Position entfernen" Click="RemoveLine"/></StackPanel></Grid><DataGrid x:Name="LineGrid" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="190" Margin="0,10,0,0" CurrentCellChanged="LineChanged"><DataGrid.Columns><DataGridTextColumn Header="Bezeichnung" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="Einzelpreis" Binding="{Binding UnitPrice}" Width="85"/><DataGridTextColumn x:Name="VatColumn" Header="USt. %" Binding="{Binding VatRate}" Width="65"/><DataGridTextColumn Header="Rabatt %" Binding="{Binding DiscountPercent}" Width="70"/><DataGridTextColumn Header="Netto" Binding="{Binding NetAmount,StringFormat=N2}" IsReadOnly="True" Width="80"/></DataGrid.Columns></DataGrid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1"><Grid><TextBlock Text="Nettosumme"/><TextBlock x:Name="NetText" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><Grid Margin="0,6,0,0"><TextBlock Text="Umsatzsteuer"/><TextBlock x:Name="VatText" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><Grid Margin="0,8,0,0"><TextBlock Text="Gesamtsumme" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="GrossText" HorizontalAlignment="Right" FontSize="17" FontWeight="Bold" Foreground="#14532D"/></Grid></StackPanel></Grid><TextBlock Text="Einleitungstext" Margin="0,16,0,5"/><TextBox x:Name="IntroBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Schlusstext" Margin="0,12,0,5"/><TextBox x:Name="ClosingBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Interne Notiz" Margin="0,12,0,5"/><TextBox x:Name="NoteBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Entwurf speichern" Click="SaveDraft"/><Button x:Name="DiscardButton" Content="Änderungen verwerfen" Click="Discard"/><Button x:Name="FinalizeButton" Style="{StaticResource PrimaryButton}" Content="Rechnung abschließen" Click="Finalize"/><Button x:Name="CancelButton" Content="Rechnung stornieren" Click="Cancel"/><Button x:Name="PaymentButton" Style="{StaticResource PrimaryButton}" Content="Zahlung erfassen" Click="OpenPaymentEntry"/><Button x:Name="PreviewButton" Style="{StaticResource PrimaryButton}" Content="Rechnungsvorschau" Click="Preview"/></StackPanel><TextBlock x:Name="StatusText" Foreground="#14532D" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></ScrollViewer></Border></Grid></Grid></UserControl>