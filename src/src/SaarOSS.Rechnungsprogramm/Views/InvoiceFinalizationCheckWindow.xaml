<Window x:Class="SaarOSS.Rechnungsprogramm.Views.InvoiceFinalizationCheckWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rechnung vor Abschluss prüfen" Width="720" Height="720" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F4F7F5"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Rechnung vor Abschluss prüfen" FontSize="26" FontWeight="Bold"/><TextBlock Text="Die Rechnung erhält nach der Bestätigung eine endgültige Nummer und wird gegen normale Änderungen geschützt." Foreground="#52625A" TextWrapping="Wrap" Margin="0,7,0,16"/></StackPanel><Border Grid.Row="1" Background="#EFF7F2" BorderBrush="#B8D7C2" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Vorgesehene Rechnungsnummer" Foreground="#52625A"/><TextBlock x:Name="NumberText" FontSize="20" FontWeight="Bold" Foreground="#14532D" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Gesamtbetrag" Foreground="#52625A" HorizontalAlignment="Right"/><TextBlock x:Name="TotalText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></Border><Border Grid.Row="2" Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="9" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="SummaryText" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="CheckList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E5EBE7" BorderThickness="0,0,0,1" Padding="5,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" FontSize="17" Foreground="{Binding Color}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="#52625A" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><Grid Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="BlockingText" Foreground="#A11B1B" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Zurück zur Rechnung" Click="Cancel"/><Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Prüfung bestanden – Rechnung abschließen" Click="Confirm" Margin="10,0,0,0"/></StackPanel></Grid></Grid></Window>