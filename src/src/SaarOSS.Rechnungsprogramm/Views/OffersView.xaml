<UserControl x:Class="SaarOSS.Rechnungsprogramm.Views.OffersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><TextBlock Text="Angebote" FontSize="27" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Nummernkreis" Click="ToggleNumbering"/><Button Style="{StaticResource PrimaryButton}" Content="+ Neues Angebot" Click="NewOffer"/></StackPanel></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="455"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Border x:Name="NumberingCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,12"><StackPanel><TextBlock Text="Angebotsnummernkreis" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="PrefixBox" Margin="0,0,8,0"/><TextBox x:Name="DigitsBox" Grid.Column="1" Margin="0,0,8,0"/><TextBox x:Name="NextBox" Grid.Column="2"/></Grid><CheckBox x:Name="YearBox" Content="Jahreszahl aufnehmen" Margin="0,10,0,0"/><TextBlock x:Name="NumberPreview" Foreground="#14532D" FontWeight="SemiBold" Margin="0,8,0,8"/><Button Style="{StaticResource PrimaryButton}" Content="Nummernkreis speichern" Click="SaveNumbering" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Angebote" FontSize="19" FontWeight="SemiBold"/><ListView x:Name="OfferList" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="OfferSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.View><GridView><GridViewColumn Header="Nummer" Width="130" DisplayMemberBinding="{Binding DisplayNumber}"/><GridViewColumn Header="Kunde" Width="115" DisplayMemberBinding="{Binding CustomerName}"/><GridViewColumn Header="Status" Width="98" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Betrag" Width="92" DisplayMemberBinding="{Binding GrossTotalDisplay}"/></GridView></ListView.View></ListView></Grid></Border></StackPanel><Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="20,20,12,20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid><TextBlock x:Name="EditorTitle" Text="Neues Angebot" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="OfferNumberText" HorizontalAlignment="Right" Foreground="#52625A"/></Grid><Border Background="#EFF7F2" BorderBrush="#B8D7C2" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,12"><TextBlock x:Name="StatusText" FontWeight="SemiBold"/></Border><StackPanel x:Name="EditorPanel"><TextBlock Text="Kunde *"/><ComboBox x:Name="CustomerBox" Height="36" Margin="0,5,0,0"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Angebotsdatum"/><DatePicker x:Name="OfferDateBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Gültig bis"/><DatePicker x:Name="ValidUntilBox" Margin="0,5,0,0"/></StackPanel></Grid><Grid Margin="0,16,0,0"><TextBlock Text="Positionen" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ Position" Click="AddLine"/><Button Content="Position entfernen" Click="RemoveLine"/></StackPanel></Grid><DataGrid x:Name="LineGrid" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="190" Margin="0,10,0,0" CurrentCellChanged="LineChanged"><DataGrid.Columns><DataGridTextColumn Header="Bezeichnung" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="Einzelpreis" Binding="{Binding UnitPrice}" Width="85"/><DataGridTextColumn x:Name="VatColumn" Header="USt. %" Binding="{Binding VatRate}" Width="65"/><DataGridTextColumn Header="Rabatt %" Binding="{Binding DiscountPercent}" Width="70"/></DataGrid.Columns></DataGrid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1"><TextBlock x:Name="NetText" TextAlignment="Right"/><TextBlock x:Name="VatText" TextAlignment="Right" Margin="0,5"/><TextBlock x:Name="GrossText" TextAlignment="Right" FontSize="17" FontWeight="Bold" Foreground="#14532D"/></StackPanel></Grid><TextBlock Text="Einleitungstext" Margin="0,12,0,5"/><TextBox x:Name="IntroBox" Height="55" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Schlusstext" Margin="0,12,0,5"/><TextBox x:Name="ClosingBox" Height="55" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel><WrapPanel Margin="0,18,0,0"><Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Entwurf speichern" Click="SaveDraft"/><Button x:Name="FinalizeButton" Style="{StaticResource PrimaryButton}" Content="Angebot abschließen" Click="Finalize"/><Button x:Name="PreviewButton" Content="Vorschau / PDF" Click="Preview"/><Button x:Name="AcceptButton" Content="Als angenommen markieren" Click="Accept"/><Button x:Name="RejectButton" Content="Als abgelehnt markieren" Click="Reject"/><Button x:Name="InvoiceButton" Style="{StaticResource PrimaryButton}" Content="In Rechnung übernehmen" Click="CreateInvoice"/></WrapPanel></StackPanel></ScrollViewer></Border></Grid></Grid></UserControl>