<UserControl x:Class="SaarOSS.Rechnungsprogramm.Views.UpdateCenterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="1000">
  <TextBlock Text="Update-Center" FontSize="28" FontWeight="Bold" Margin="0,0,0,22"/>
  <Border Background="White" BorderBrush="#D8E0DB" BorderThickness="1" CornerRadius="10" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Installierte Version" Foreground="#6B756F"/><TextBlock x:Name="InstalledVersionText" Text="1.0.0" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Updatekanal: Stabil" Foreground="#8B692B"/></StackPanel><Button Grid.Column="1" Content="Nach Updates suchen" Click="CheckOnline" VerticalAlignment="Center"/></Grid></Border>
  <Border Background="White" BorderBrush="#D8E0DB" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,16,0,0"><StackPanel>
   <TextBlock Text="Verf&#x00FC;gbares Update" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="OnlineInfoText" Text="Noch nicht gepr&#x00FC;ft." Margin="0,8,0,0" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,14,0,0"><Button x:Name="DownloadButton" Content="Update-ZIP herunterladen" Click="DownloadZip" IsEnabled="False"/><Button Content="Heruntergeladenes ZIP ausw&#x00E4;hlen" Click="SelectZip"/><Button Content="Downloadordner &#x00F6;ffnen" Click="OpenDownloads"/></WrapPanel>
  </StackPanel></Border>
  <Border Background="White" BorderBrush="#D8E0DB" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,16,0,0"><StackPanel>
   <TextBlock Text="Ausgew&#x00E4;hltes Updatepaket" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SelectedFileText" Text="Kein ZIP ausgew&#x00E4;hlt." Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="PackageInfoText" Margin="0,5,0,0" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,14,0,0"><Button x:Name="VerifyButton" Content="Update pr&#x00FC;fen" Click="VerifyZip" IsEnabled="False"/><Button x:Name="InstallButton" Content="Update jetzt einspielen" Click="InstallZip" IsEnabled="False"/></WrapPanel>
  </StackPanel></Border>
  <Border Background="#FFF8E3" BorderBrush="#E4C667" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><TextBlock Text="Updates werden als ZIP-Datei ausschlie&#x00DF;lich &#x00FC;ber saaross.de bereitgestellt. Download und Installation erfolgen nur nach ausdr&#x00FC;cklicher Best&#x00E4;tigung. Vor der Installation wird automatisch eine vollst&#x00E4;ndige Programmsicherung erstellt." TextWrapping="Wrap"/></Border>
  <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#14532D"/>
 </StackPanel></ScrollViewer>
</UserControl>