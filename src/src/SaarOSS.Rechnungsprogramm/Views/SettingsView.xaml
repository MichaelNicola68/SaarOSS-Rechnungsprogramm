<UserControl x:Class="SaarOSS.Rechnungsprogramm.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Unternehmensdaten" FontSize="27" FontWeight="Bold"/><TextBlock Text="Diese Angaben bilden später die Grundlage für Angebote und Rechnungen." Foreground="#52625A" Margin="0,6,0,22"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Unternehmen" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Unternehmensname *"/><TextBox x:Name="CompanyNameBox" Margin="0,5,0,14"/><TextBlock Text="Inhaber oder Ansprechpartner"/><TextBox x:Name="OwnerNameBox" Margin="0,5,0,14"/><TextBlock Text="Straße und Hausnummer"/><TextBox x:Name="StreetBox" Margin="0,5,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PLZ"/><TextBox x:Name="PostalCodeBox" Margin="0,5,0,0" MaxLength="10"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ort"/><TextBox x:Name="CityBox" Margin="0,5,0,0"/></StackPanel></Grid></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kontakt und Abrechnung" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="E-Mail-Adresse"/><TextBox x:Name="EmailBox" Margin="0,5,0,14"/><TextBlock Text="Telefon"/><TextBox x:Name="PhoneBox" Margin="0,5,0,14"/><TextBlock Text="Steuernummer"/><TextBox x:Name="TaxNumberBox" Margin="0,5,0,14"/><TextBlock Text="Umsatzsteuer-ID (optional)"/><TextBox x:Name="VatIdBox" Margin="0,5,0,14"/><TextBlock Text="IBAN"/><TextBox x:Name="IbanBox" Margin="0,5,0,14" CharacterCasing="Upper"/><TextBlock Text="Standard-Zahlungsziel in Tagen"/><TextBox x:Name="PaymentTermBox" Margin="0,5,0,14"/><CheckBox x:Name="SmallBusinessBox" Content="Kleinunternehmerregelung verwenden" Visibility="Collapsed"/></StackPanel></Border><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Content="Unternehmensdaten speichern" Click="SaveSettings"/><Button Content="Gespeicherten Stand laden" Click="ReloadSettings"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,8" Foreground="#14532D" FontWeight="SemiBold"/></StackPanel><Border Background="#EFF7F2" BorderBrush="#B8D7C2" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,18,0">
   <TextBlock Text="Besteuerung" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="Regelbesteuerung oder Kleinunternehmer gemäß § 19 UStG festlegen." Foreground="#52625A" Margin="0,4,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Button Grid.Column="1" VerticalAlignment="Center" Content="Besteuerung öffnen" Click="OpenTaxProfile" Margin="0"/>
 </Grid>
</Border><Border Background="#EFF7F2" BorderBrush="#B8D7C2" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Logo und Briefkopf" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Unternehmenslogo und ergänzende Briefkopfzeilen verwalten." Foreground="#52625A" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Content="Logo und Briefkopf öffnen" Click="OpenDocumentDesign" Margin="0"/></Grid></Border><Border Background="#EFF7F2" BorderBrush="#B8D7C2" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Zahlungs- und Fußbereich" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Bankverbindung, Zahlungstext und optionale Fußzeilen verwalten." Foreground="#52625A" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Content="Zahlungsbereich öffnen" Click="OpenPaymentFooter" Margin="0"/></Grid></Border><Border Background="#FFF1F1" BorderBrush="#D9A6A6" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Lokale Daten zurücksetzen" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Ausgewählte Programmdaten nach automatischer Sicherung sicher leeren." Foreground="#6B4B4B" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Content="Daten zurücksetzen" Click="OpenLocalDataReset" Margin="0"/></Grid></Border></StackPanel></ScrollViewer></UserControl>