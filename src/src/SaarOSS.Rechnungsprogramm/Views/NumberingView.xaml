<UserControl x:Class="SaarOSS.Rechnungsprogramm.Views.NumberingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left"><TextBlock Text="Nummernkreise" FontSize="27" FontWeight="Bold"/><TextBlock Text="Startwerte können von Hand geändert werden. Nach jeder erfolgreichen Vergabe zählt das Programm automatisch weiter." Foreground="#52625A" TextWrapping="Wrap" Margin="0,6,0,22"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kundennummernkreis" FontSize="19" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="16"/><ColumnDefinition Width="140"/><ColumnDefinition Width="16"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Präfix"/><TextBox x:Name="CustomerPrefixBox" Margin="0,5,0,0" TextChanged="Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Stellenzahl"/><TextBox x:Name="CustomerDigitsBox" Margin="0,5,0,0" TextChanged="Changed"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Nächste Nummer"/><TextBox x:Name="CustomerNextBox" Margin="0,5,0,0" TextChanged="Changed"/></StackPanel></Grid><TextBlock x:Name="CustomerPreviewText" Foreground="#14532D" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,10"/><Button Style="{StaticResource PrimaryButton}" Content="Kundennummernkreis speichern" Click="SaveCustomerNumbering" HorizontalAlignment="Left"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Rechnungsnummernkreis" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Eine endgültige Rechnungsnummer wird erst beim Abschluss eines Entwurfs vergeben." Foreground="#52625A" Margin="0,6,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="130"/><ColumnDefinition Width="16"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Präfix"/><TextBox x:Name="InvoicePrefixBox" Margin="0,5,0,0" TextChanged="Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Stellenzahl"/><TextBox x:Name="InvoiceDigitsBox" Margin="0,5,0,0" TextChanged="Changed"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Nächste Nummer"/><TextBox x:Name="InvoiceNextBox" Margin="0,5,0,0" TextChanged="Changed"/></StackPanel></Grid><CheckBox x:Name="IncludeYearBox" Content="Jahreszahl in die Rechnungsnummer aufnehmen" IsChecked="True" Margin="0,14,0,0" Click="ChangedClick"/><TextBlock x:Name="InvoicePreviewText" Foreground="#14532D" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,10"/><Button Style="{StaticResource PrimaryButton}" Content="Rechnungsnummernkreis speichern" Click="SaveInvoiceNumbering" HorizontalAlignment="Left"/></StackPanel></Border>
</StackPanel></ScrollViewer></UserControl>