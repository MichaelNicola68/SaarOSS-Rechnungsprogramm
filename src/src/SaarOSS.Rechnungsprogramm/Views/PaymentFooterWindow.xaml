<Window x:Class="SaarOSS.Rechnungsprogramm.Views.PaymentFooterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Zahlungs- und Fußbereich" Width="820" Height="820" MinWidth="720" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F4F7F5"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26"><TextBlock Text="Zahlungs- und Fußbereich" FontSize="28" FontWeight="Bold"/><TextBlock Text="Bankverbindung, Zahlungsanweisung und optionale Fußzeilen verwalten. Die Dokumentausgabe wird nach erfolgreichem Basistest getrennt verbunden." Foreground="#52625A" TextWrapping="Wrap" Margin="0,8,0,18"/><Border Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="Bankverbindung" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="InvoiceBox" Content="Bankverbindung auf Rechnungen anzeigen" Margin="0,12,0,0"/><CheckBox x:Name="OfferBox" Content="Bankverbindung auf Angeboten anzeigen" Margin="0,8,0,14"/><TextBlock Text="Kontoinhaber"/><TextBox x:Name="HolderBox" MaxLength="120" Margin="0,5,0,10"/><TextBlock Text="Bank"/><TextBox x:Name="BankBox" MaxLength="120" Margin="0,5,0,10"/><TextBlock Text="IBAN"/><TextBox x:Name="IbanBox" MaxLength="42" Margin="0,5,0,10"/><TextBlock Text="BIC (optional)"/><TextBox x:Name="BicBox" MaxLength="11" Margin="0,5,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Zahlungstext" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Zahlungsanweisung" Margin="0,12,0,0"/><TextBox x:Name="InstructionBox" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" Margin="0,5,0,10"/><TextBlock Text="Verwendungszweck-Vorlage"/><TextBox x:Name="PurposeBox" MaxLength="180" Margin="0,5,0,0"/><TextBlock Text="Platzhalter: {Rechnungsnummer} und {Kundennummer}" Foreground="#52625A" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Optionale Fußzeilen" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Leere Zeilen werden später nicht ausgegeben." Foreground="#52625A" Margin="0,5,0,12"/><TextBox x:Name="Footer1Box" MaxLength="160" Margin="0,0,0,9"/><TextBox x:Name="Footer2Box" MaxLength="160" Margin="0,0,0,9"/><TextBox x:Name="Footer3Box" MaxLength="160" Margin="0,0,0,9"/><TextBox x:Name="Footer4Box" MaxLength="160"/></StackPanel></Border><Border Background="#FFF8E6" BorderBrush="#E3C66F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><TextBlock Text="Sicherheitsstufe Basis: Bankdaten werden lokal atomar gespeichert und in die bestehende Programmdatensicherung aufgenommen. Bestehende Dokumente werden noch nicht verändert." TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Zahlungs- und Fußbereich speichern" Click="Save"/><Button Content="Schließen" Click="CloseWindow" Margin="10,0,0,0"/></StackPanel></StackPanel></ScrollViewer></Window>