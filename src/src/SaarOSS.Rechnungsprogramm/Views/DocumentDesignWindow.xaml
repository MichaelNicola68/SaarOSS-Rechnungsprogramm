<Window x:Class="SaarOSS.Rechnungsprogramm.Views.DocumentDesignWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Logo und Briefkopf" Width="800" Height="680" MinWidth="700" MinHeight="580" WindowStartupLocation="CenterOwner" Background="#F4F7F5"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26"><TextBlock Text="Logo und Briefkopf" FontSize="28" FontWeight="Bold"/><TextBlock Text="Logo sicher einlesen und die Zusatzzeilen des Briefkopfs vorbereiten. Die Dokumentausgabe wird im nächsten getrennten Schritt verbunden." Foreground="#52625A" TextWrapping="Wrap" Margin="0,8,0,18"/><Border Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="10" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="220" Height="150" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="8" Background="#FAFCFB"><Grid><TextBlock x:Name="NoLogoText" Text="Kein Logo ausgewählt" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B7770"/><Image x:Name="LogoImage" Stretch="Uniform" Margin="10"/></Grid></Border><StackPanel Grid.Column="2"><CheckBox x:Name="ShowLogoBox" Content="Logo in Dokumenten anzeigen"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Logo auswählen" Click="ChooseLogo"/><Button Content="Logo entfernen" Click="RemoveLogo" Margin="10,0,0,0"/></StackPanel><TextBlock Text="Erlaubt: PNG, JPG und BMP. Das Bild wird geprüft, auf höchstens 5 MB begrenzt und intern als PNG gespeichert. Der ursprüngliche Dateipfad wird nicht benötigt." TextWrapping="Wrap" Foreground="#52625A" Margin="0,12,0,0"/></StackPanel></Grid></Border><Border Background="White" BorderBrush="#D7DFDA" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Briefkopf-Zusatzzeilen" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Die vorhandenen Unternehmensdaten bleiben die Hauptquelle. Hier können bis zu vier ergänzende Zeilen gespeichert werden." TextWrapping="Wrap" Foreground="#52625A" Margin="0,5,0,14"/><TextBlock Text="Zusatzzeile 1"/><TextBox x:Name="Line1Box" MaxLength="120" Margin="0,5,0,12"/><TextBlock Text="Zusatzzeile 2"/><TextBox x:Name="Line2Box" MaxLength="120" Margin="0,5,0,12"/><TextBlock Text="Zusatzzeile 3"/><TextBox x:Name="Line3Box" MaxLength="120" Margin="0,5,0,12"/><TextBlock Text="Zusatzzeile 4"/><TextBox x:Name="Line4Box" MaxLength="120" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#FFF8E6" BorderBrush="#E3C66F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><TextBlock Text="Sicherheitsstufe Basis: Dieses Update speichert Logo und Briefkopfeinstellungen, verändert aber noch keine bestehenden Angebote, Rechnungen, Vorschauen oder PDFs." TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Logo und Briefkopf speichern" Click="Save"/><Button Content="Schließen" Click="CloseWindow" Margin="10,0,0,0"/></StackPanel></StackPanel></ScrollViewer></Window>